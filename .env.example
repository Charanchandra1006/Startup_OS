# Chief — Environment Configuration
# Copy this file to .env and fill in values

# ─── Database: Operational Store ──────────────────────────────────────
OPERATIONAL_DB_HOST=localhost
OPERATIONAL_DB_PORT=5432
OPERATIONAL_DB_NAME=chief_operational
OPERATIONAL_DB_USER=chief_app
OPERATIONAL_DB_PASSWORD=changeme_operational

# ─── Database: Financial/Legal Store ──────────────────────────────────
FINANCIAL_DB_HOST=localhost
FINANCIAL_DB_PORT=5433
FINANCIAL_DB_NAME=chief_financial
FINANCIAL_DB_USER=chief_financial_app
FINANCIAL_DB_PASSWORD=changeme_financial

# ─── Database: Document/Vector Store ──────────────────────────────────
DOCUMENTS_DB_HOST=localhost
DOCUMENTS_DB_PORT=5434
DOCUMENTS_DB_NAME=chief_documents
DOCUMENTS_DB_USER=chief_docs_app
DOCUMENTS_DB_PASSWORD=changeme_documents

# ─── Credential Vault ────────────────────────────────────────────────
# For dev: uses local env-backed vault abstraction
# For prod: use managed secrets service (AWS Secrets Manager, GCP Secret Manager, etc.)
VAULT_BACKEND=local
VAULT_ENCRYPTION_KEY=changeme_vault_key_32_bytes_long!

# ─── API Gateway ─────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
JWT_SECRET=changeme_jwt_secret
JWT_ISSUER=chief-dev

# ─── Service URLs (internal) ─────────────────────────────────────────
ORCHESTRATOR_URL=http://localhost:8000
EXECUTION_SERVICE_URL=http://localhost:8001
TOOL_GATEWAY_URL=http://localhost:8002
APPROVAL_WORKFLOW_URL=http://localhost:8003
AGENT_ECHO_URL=http://localhost:8010

# ─── Observability ───────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=chief
JAEGER_UI_PORT=16686

# ─── AI Model Configuration ─────────────────────────────────────────
# Model Router config (Supports Gemini and OpenAI with automatic fallback)
GEMINI_API_KEY=AIzaSy_changeme_gemini_key
OPENAI_API_KEY=sk-changeme_openai_key

# ─── Environment ─────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
